# datasets, videos and training outputs are large: keep them out of git
# everything under data/ is ignored except the .gitkeep placeholder
data/*
!data/.gitkeep
runs/

# images, videos and dataset caches anywhere in the repo
*.jpg
*.jpeg
*.png
*.bmp
*.webp
*.gif
*.mp4
*.avi
*.mov
*.mkv
*.cache

# model weights and exports
*.pt
*.pth
*.weights
*.engine
*.onnx
*.tflite
*_ncnn_model/
*.mlpackage/
*_saved_model/
.env
__pycache__/
*.pyc
.venv/
venv/

# user test photos and comparison outputs
test_photos/
results/compare/
frontend/node_modules/
frontend/dist/
frontend/dashboard-preview.png
frontend/*.tsbuildinfo
backend/straywatch.db
results/events*.jsonl
results/**/events*.jsonl
results/**/camera_*.log
backend/storage/snapshots/*.svg
backend/storage/snapshots/*.png
backend/storage/snapshots/*.jpg
backend/storage/snapshots/*.webp
